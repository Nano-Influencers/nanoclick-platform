**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/

# Firebase Hosting build cache (Firebase is being removed from this app —
# see /docs/architecture.md — this is stale hosting cache, not source)
.firebase/

# assets/env_temp.txt used to contain a live Paystack secret key + Monnify
# keys and was excluded from git entirely for that reason. It's since been
# replaced with a safe, secret-free placeholder (see the file itself and
# docs/architecture.md) now that payments go through the backend — so it's
# fine to track normally and no longer needs an ignore entry here.
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
