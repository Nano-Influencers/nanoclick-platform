DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/nanoclick_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-this-to-a-very-long-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET_NAME=nanoclick-proofs

APP_ENV=development
FRONTEND_ORIGINS=http://localhost,http://localhost:5173,https://yourdomain.com

MIDNIGHT_START_HOUR=0
MIDNIGHT_END_HOUR=5
AUTO_APPROVE_HOURS=72
DEFAULT_TASK_ACCEPT_MINUTES=30
TARGETING_EXPANSION_HOURS=6

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

OAUTH_REDIRECT_BASE=http://localhost:8000
# Where a *web* OAuth login (click-workers, which is a web-only Flutter
# build) redirects to after auth, since the nanoclick:// mobile deep link
# doesn't apply in a browser. Point this at your frontend's callback route.
OAUTH_WEB_REDIRECT_URL=http://localhost:5173/oauth-callback

# Gamification amounts (kobo) — see app/services/rewards_service.py for how
# these were inferred from the Flutter client and why they're configurable
# constants rather than hardcoded.
REFERRAL_BONUS_KOBO=20000
CHECKIN_BASE_REWARD_KOBO=5000
CHECKIN_STREAK_STEP_KOBO=2500
CHECKIN_STREAK_CAP_DAYS=7
SPIN_COOLDOWN_HOURS=24
